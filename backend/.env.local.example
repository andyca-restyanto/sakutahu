# filepath: /backend/.env.local.example
# DEVELOPMENT. Salin jadi backend/.env.local (tidak di-commit), lalu isi bagian Telegram.
# Dibaca otomatis oleh profile "local" (default) saat backend dijalankan dari folder backend.

DB_URL=jdbc:postgresql://localhost:5432/sakutahu
DB_USERNAME=sakutahu
DB_PASSWORD=sakutahu

# Bebas, minimal 32 karakter. Jangan dipakai ulang di production.
JWT_SECRET=dev-only-secret-change-me-please-32chars-min!!

# Isi dengan URL ngrok jika ingin tes Telegram; selain itu biarkan localhost
APP_FRONTEND_URL=https://unless-pleat-puzzle.ngrok-free.dev
APP_BACKEND_URL=https://unless-pleat-puzzle.ngrok-free.dev
APP_CORS_ORIGINS=http://localhost:5173,https://unless-pleat-puzzle.ngrok-free.dev
COOKIE_SECURE=false

# --- Email: pilih SALAH SATU blok ---
# (a) Mailpit dari docker-compose.yml, email tidak benar-benar terkirim (lihat di http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=SakuTahu Dev <no-reply@sakutahu.local>

# (b) Gmail sungguhan: hapus blok (a), aktifkan blok ini.
# MAIL_PASSWORD = App Password 16 karakter (myaccount.google.com/apppasswords), BUKAN password akun.
# MAIL_FROM harus memakai alamat Gmail yang sama dengan MAIL_USERNAME.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=akunkamu@gmail.com
# MAIL_PASSWORD=abcdefghijklmnop
# MAIL_FROM=SakuTahu <akunkamu@gmail.com>

# Bot KHUSUS development (mis. @SakuTahuDevBot), terpisah dari bot production
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SakuTahuDevBot
TELEGRAM_WEBHOOK_SECRET=

# ---------- Baca struk (Claude Vision) ----------
# API key dari https://console.anthropic.com → API Keys. Kosong = fitur struk nonaktif (bot membalas "belum aktif").
ANTHROPIC_API_KEY=
# Wajib HANYA jika key tidak terikat ke satu workspace. ID ada di Console → Settings → Workspaces (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# Opsional: model & batas ukuran file (MB)
# RECEIPT_AI_MODEL=claude-haiku-5-5
# RECEIPT_MAX_FILE_MB=7

# ---------- Panel admin (/admin) ----------
# Secret JWT admin, WAJIB berbeda dari JWT_SECRET. Kosongkan baris ini (beri #) untuk memakai default dev.
# ADMIN_JWT_SECRET=
# OWNER pertama dibuat otomatis saat backend start, HANYA jika belum ada admin sama sekali.
# Password awal wajib diganti saat login pertama; setelah OWNER ada, dua baris ini boleh dihapus.
ADMIN_BOOTSTRAP_EMAIL=andyca.restyanto03@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=
