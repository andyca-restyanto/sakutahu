# filepath: /backend/.env.production.example
# PRODUCTION. Isi variabel ini di dashboard hosting / secret manager, ATAU salin jadi
# backend/.env.production di server (tidak di-commit, chmod 600).
# Jalankan dengan SPRING_PROFILES_ACTIVE=prod. Semua variabel di bawah WAJIB diisi,
# kecuali yang ditandai opsional; aplikasi gagal start jika ada yang kosong.

# SPRING_PROFILES_ACTIVE=prod harus di-set sebagai environment variable proses / argumen
# (--spring.profiles.active=prod), bukan di file ini, karena file ini baru dibaca setelah profile aktif.

# Format file: KEY=nilai, tanpa tanda kutip. Hindari karakter $ (diartikan variabel oleh Docker Compose).

# Deploy dengan docker-compose.prod.yml: DB_URL/DB_USERNAME/DB_PASSWORD DIABAIKAN,
# karena diambil dari POSTGRES_* di file .env root. Isi tiga baris ini hanya jika memakai DB eksternal tanpa Docker.
DB_URL=jdbc:postgresql://<host-db>:5432/sakutahu?sslmode=require
DB_USERNAME=sakutahu_app
DB_PASSWORD=<password-kuat>
# Opsional, default 10
DB_POOL_SIZE=10

# Buat baru: openssl rand -base64 48
JWT_SECRET=<minimal-32-karakter-acak>

APP_FRONTEND_URL=https://sakutahu.id
APP_BACKEND_URL=https://sakutahu.id
APP_CORS_ORIGINS=https://sakutahu.id

# SMTP. Pilih SATU mode enkripsi sesuai port penyedia email:
#   Port 465 (SSL/TLS langsung) → MAIL_SSL=true,  MAIL_STARTTLS=false
#   Port 587 (STARTTLS)         → MAIL_SSL=false, MAIL_STARTTLS=true
#
# Contoh Sumopod (port 465, SSL):
MAIL_HOST=smtp.sumopod.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USERNAME=<username-smtp-sumopod>
MAIL_PASSWORD=<password-smtp-sumopod>
# MAIL_FROM harus alamat/domain pengirim yang sudah diverifikasi di penyedia SMTP
MAIL_FROM=SakuTahu <no-reply@domain-kamu.com>
#
# Contoh Gmail (port 587, STARTTLS). MAIL_PASSWORD = App Password 16 karakter:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SSL=false
# MAIL_STARTTLS=true
# MAIL_USERNAME=<akun>@gmail.com
# MAIL_PASSWORD=<app-password-16-karakter>
# MAIL_FROM=SakuTahu <<akun>@gmail.com>

# Bot production (@SakuTahuBot)
TELEGRAM_BOT_TOKEN=<token-dari-botfather>
TELEGRAM_BOT_USERNAME=SakuTahuBot
# Buat baru: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=<hex-acak>

# ---------- Baca struk (Claude Vision) ----------
# WAJIB di production (aplikasi gagal start jika kosong)
ANTHROPIC_API_KEY=<api-key-anthropic>
# Wajib HANYA jika key tidak terikat ke satu workspace. ID ada di Console → Settings → Workspaces (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# RECEIPT_AI_MODEL=claude-haiku-5-5
# RECEIPT_MAX_FILE_MB=7
