# filepath: /frontend/.env.production
# Dipakai oleh `npm run build`. Boleh di-commit: variabel VITE_* bersifat publik (ikut ke browser).
# Nama bot Telegram tidak diatur di sini; frontend menerimanya dari backend.

# Kosong = API di origin yang sama (reverse proxy /api → backend). Isi URL backend jika beda domain.
VITE_API_BASE_URL=
