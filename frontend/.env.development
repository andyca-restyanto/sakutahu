# filepath: /frontend/.env.development
# Dipakai oleh `npm run dev`. Boleh di-commit: variabel VITE_* bersifat publik (ikut ke browser).
# Override pribadi taruh di .env.development.local (tidak di-commit).
# Nama bot Telegram tidak diatur di sini; frontend menerimanya dari backend.

# Kosong = lewat proxy Vite ke http://localhost:8080
VITE_API_BASE_URL=
