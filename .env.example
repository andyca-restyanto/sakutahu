# filepath: /.env.example
# Dipakai docker-compose.prod.yml. Salin ke .env di server lalu isi:  cp .env.example .env
# File .env TIDAK di-commit.

# Domain yang DNS A-record-nya sudah mengarah ke IP server (tanpa https://)
DOMAIN=sakutahu.id
# Email untuk notifikasi Let's Encrypt (sertifikat HTTPS)
ACME_EMAIL=admin@sakutahu.id

# Database (container postgres dibuat dengan nilai ini saat pertama kali jalan)
POSTGRES_DB=sakutahu
POSTGRES_USER=sakutahu
# Buat acak: openssl rand -hex 24   (hindari karakter $)
POSTGRES_PASSWORD=
