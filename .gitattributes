# filepath: /.gitattributes
# Pastikan file yang dijalankan di Linux selalu ber-line-ending LF,
# meski repo di-commit dari Windows (CRLF membuat script & container gagal).
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.jar binary
